{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/topics/{id}": {
      "get": {
        "description": "Returns a single topic by its ID",
        "operationId": "TopicsController_findOne_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Topic ID",
            "schema": {
              "example": "html-basics",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Topic returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiSuccessResponseDto"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/TopicDtoResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Get one topic",
        "tags": [
          "Topics"
        ]
      }
    }
  },
  "info": {
    "title": "Roadmap Service API",
    "description": "API for managing roadmaps and topics",
    "version": "1.0",
    "contact": {

    }
  },
  "tags": [],
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "NOT_FOUND",
            "description": "Machine-readable error code."
          },
          "message": {
            "type": "string",
            "example": "Topic not found",
            "description": "Human-readable error message."
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false,
            "description": "Indicates whether the request was successful."
          },
          "error": {
            "description": "Error details.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ApiErrorDto"
              }
            ]
          },
          "timestamp": {
            "type": "string",
            "example": "2026-06-14T09:41:54.000Z",
            "description": "ISO timestamp when the response was generated."
          }
        },
        "required": [
          "success",
          "error",
          "timestamp"
        ]
      },
      "ApiSuccessResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true,
            "description": "Indicates whether the request was successful."
          },
          "data": {
            "type": "object",
            "description": "Returned response data."
          },
          "timestamp": {
            "type": "string",
            "example": "2026-06-14T09:41:54.000Z",
            "description": "ISO timestamp when the response was generated."
          }
        },
        "required": [
          "success",
          "data",
          "timestamp"
        ]
      },
      "PositionDto": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "example": 100,
            "description": "X coordinate of the topic in the roadmap canvas."
          },
          "y": {
            "type": "number",
            "example": 200,
            "description": "Y coordinate of the topic in the roadmap canvas."
          }
        },
        "required": [
          "x",
          "y"
        ]
      },
      "ResourceDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "article",
            "description": "Resource type, for example article, video, course, docs."
          },
          "title": {
            "type": "string",
            "example": "HTML Introduction",
            "description": "Resource title."
          },
          "link": {
            "type": "string",
            "example": "https://developer.mozilla.org/en-US/docs/Web/HTML",
            "description": "Resource URL."
          }
        },
        "required": [
          "type",
          "title",
          "link"
        ]
      },
      "TopicDtoResponse": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "string",
            "example": "html-basics",
            "description": "Unique topic ID used by the application."
          },
          "name": {
            "type": "string",
            "example": "HTML Basics",
            "description": "Internal topic name."
          },
          "label": {
            "type": "string",
            "example": "HTML",
            "description": "Display label shown on the roadmap UI."
          },
          "description": {
            "type": "string",
            "example": "Learn the basics of HTML structure and semantic elements.",
            "description": "Topic description."
          },
          "type": {
            "type": "string",
            "enum": [
              "topic",
              "subtopic"
            ],
            "example": "topic",
            "description": "Topic type."
          },
          "roadmapId": {
            "type": "string",
            "example": "frontend-roadmap",
            "description": "ID of the roadmap this topic belongs to."
          },
          "position": {
            "description": "Topic position in the roadmap canvas.",
            "allOf": [
              {
                "$ref": "#/components/schemas/PositionDto"
              }
            ]
          },
          "resources": {
            "description": "Learning resources related to this topic.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceDto"
            }
          },
          "parentTopicId": {
            "type": "string",
            "example": "anything",
            "description": "Direct parent topicId"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-06-14T09:41:54.000Z",
            "description": "Date when the topic was created."
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-06-14T09:41:54.000Z",
            "description": "Date when the topic was last updated."
          }
        },
        "required": [
          "topicId",
          "name",
          "label",
          "description",
          "type",
          "roadmapId",
          "position",
          "resources",
          "parentTopicId"
        ]
      }
    }
  }
}