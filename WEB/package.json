{
  "name": "ilma-mvp",
  "version": "1.0.0",
  "description": "ILMA is a modern, AI-powered recommendation system website for Software Engineering (SWE) courses designed specifically for Arabic-speaking users. The platform personalizes course recommendations based on user behavior, skill level, and learning goals.",
  "license": "ISC",
  "author": "ITI-ALEX-TEAM-",
  "type": "module",
  "main": "backend-nestjs/dist/main.js",
  "scripts": {
    "test": "npm test --prefix backend-nestjs",
    "test:express": "node --test \"backend/test/**/*.test.js\"",
    "start": "npm run start:prod --prefix backend-nestjs",
    "start:express": "cross-env NODE_ENV=production node backend/server.js",
    "dev": "npm run start:dev --prefix backend-nestjs",
    "dev:express": "cross-env  NODE_ENV=development nodemon backend/server.js",
    "dev:nestjs": "npm run start:dev --prefix backend-nestjs",
    "start:nestjs": "npm run start:prod --prefix backend-nestjs",
    "build:nestjs": "npm run build --prefix backend-nestjs"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.1",
    "nanoid": "^5.1.11",
    "nodemailer": "^8.0.7",
    "openai": "^6.42.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-dist": "^5.32.6",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  }
}
